PORT=4173
NODE_ENV=production
FLEETBASE_DATA_DIR=/var/lib/fleetbase
FLEETBASE_OWNER_EMAIL=owner@example.com
FLEETBASE_OWNER_PASSWORD=replace-with-a-long-unique-password
FLEETBASE_SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
FLEETBASE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Create an application at https://www.bouncie.dev/
BOUNCIE_CLIENT_ID=
BOUNCIE_CLIENT_SECRET=
BOUNCIE_REDIRECT_URI=https://fleet.example.com/api/bouncie/callback
BOUNCIE_WEBHOOK_KEY=replace-with-a-long-random-webhook-key
