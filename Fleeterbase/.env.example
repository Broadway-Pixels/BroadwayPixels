PORT=4173
NODE_ENV=production
FLEETERBASE_DATA_DIR=/var/lib/fleeterbase
FLEETERBASE_OWNER_EMAIL=owner@example.com
FLEETERBASE_OWNER_PASSWORD=replace-with-a-long-unique-password
FLEETERBASE_SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
FLEETERBASE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Public origin used for canonical, Open Graph, robots, and sitemap build output.
VITE_PUBLIC_SITE_URL=https://fleeterbase.com

# Create an application at https://www.bouncie.dev/
BOUNCIE_CLIENT_ID=
BOUNCIE_CLIENT_SECRET=
BOUNCIE_REDIRECT_URI=https://fleeterbase.com/api/bouncie/callback
BOUNCIE_WEBHOOK_KEY=replace-with-a-long-random-webhook-key

# Google Cloud OAuth web application with Gmail API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fleeterbase.com/api/gmail/callback

# Stripe Billing product, webhook, and secret key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
